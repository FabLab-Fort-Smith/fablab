# Managed by Ansible (lab-stack/ansible/roles/harden). Do not edit by hand.
# Coolify's control plane runs in a container and manages THIS host over SSH as
# root@host.docker.internal. The global default stays PermitRootLogin no
# (10-fablab-hardening.conf); a Match block OVERRIDES the global for matching connections,
# so this re-enables KEY-ONLY root login ONLY from the internal Docker bridge networks
# (Coolify's default-address-pool is 10.0.0.0/8) — never from the internet or the tailnet
# (100.64.0.0/10, outside 10/8). Source 10.x cannot be spoofed in from outside (it would
# arrive on eth0 and be dropped by strict rp_filter). Terminated with `Match all` so the
# conditional scope cannot leak into any later-included config.
Match Address {{ coolify_docker_ssh_cidr | default('10.0.0.0/8') }}
    PermitRootLogin prohibit-password
{% if ssh_allow_users | default([]) | length > 0 %}
    # A global `AllowUsers` (emitted by 10-fablab-hardening.conf when ssh_allow_users is set)
    # is NOT re-granted by PermitRootLogin and would silently block Coolify's root login here.
    # Re-grant root (plus the same maintainer list) within THIS address-scoped block so a later
    # ssh_allow_users lockdown can't sever the control plane. AllowUsers in a Match replaces the
    # allowed set for this scope only.
    AllowUsers root {{ ssh_allow_users | join(' ') }}
{% endif %}
Match all
