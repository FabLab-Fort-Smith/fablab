# Managed by Ansible (roles/mongodb). Sourced by the backup cron (roles/backups). 0600, root-only.
# The app connection string uses the least-privilege app user over the private docker network.
{# urlencode leaves '/' (safe char); encode it too so any password is valid in URI userinfo. #}
MONGODB_URI=mongodb://{{ mongodb_app_user }}:{{ mongodb_app_pw | urlencode | regex_replace('/', '%2F') }}@{{ mongodb_container_name }}:27017/{{ mongodb_app_db }}?authSource={{ mongodb_app_db }}
MONGO_BACKUP_NETWORK={{ mongodb_network }}
MONGO_IMAGE={{ mongodb_image }}
