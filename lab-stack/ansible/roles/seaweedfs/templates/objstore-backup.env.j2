# Managed by Ansible (lab-stack/ansible/roles/seaweedfs). READ-ONLY S3 credentials for the backup
# job only (/usr/local/sbin/fablab-backup-objstore). 0600, root-only.
#
# This identity holds Read+List on ONE bucket — no Write, no Delete, no admin. A compromised backup
# cron therefore cannot destroy or alter the data it is protecting.
S3_ENDPOINT=http://{{ seaweedfs_container_name }}:{{ seaweedfs_s3_port }}
S3_REGION={{ seaweedfs_region }}
S3_BUCKET={{ seaweedfs_bucket }}
S3_ACCESS_KEY={{ seaweedfs_backup_access_key }}
S3_SECRET_KEY={{ seaweedfs_backup_secret }}
