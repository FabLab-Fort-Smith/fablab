# Managed by Ansible (lab-stack/ansible/roles/seaweedfs). App-facing S3 settings for the
# self-hosted object storage. 0600, root-only. Issue #96.
#
# These are the values to set on the Coolify application (S3_*). The app talks to storage over the
# docker network — there is no public S3 endpoint yet (that is a separate, gated step in #96).
# This is the APP credential: scoped to one bucket. NEVER give the app the admin key.
S3_ENDPOINT=http://{{ seaweedfs_container_name }}:{{ seaweedfs_s3_port }}
S3_REGION={{ seaweedfs_region }}
S3_BUCKET={{ seaweedfs_bucket }}
S3_ACCESS_KEY={{ seaweedfs_app_access_key }}
S3_SECRET_KEY={{ seaweedfs_app_secret }}
S3_FORCE_PATH_STYLE=true
