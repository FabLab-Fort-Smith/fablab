# Managed by Ansible (roles/backups) — backup encryption + off-box config. 0600, root-only.
# Sourced by /usr/local/sbin/fablab-backup-mongo. Never commit (@rules/workflow-secrets.md).
# Empty values = feature off (the backup script falls back to local-only + warns loudly).
# String values are single-quote-escaped so any secret content is safe to `source`.
{% macro shq(v) %}'{{ v | string | replace("'", "'\\''") }}'{% endmacro -%}
{% if backups_age_recipient | length > 0 %}
# age recipient = PUBLIC key; the private identity stays OFFLINE with the maintainer.
BACKUP_AGE_RECIPIENT={{ shq(backups_age_recipient) }}
{% endif %}
{% if backups_restic_repository | length > 0 %}
RESTIC_REPOSITORY={{ shq(backups_restic_repository) }}
RESTIC_PASSWORD={{ shq(backups_restic_password) }}
{% if backups_s3_access_key_id | length > 0 %}
AWS_ACCESS_KEY_ID={{ shq(backups_s3_access_key_id) }}
AWS_SECRET_ACCESS_KEY={{ shq(backups_s3_secret_access_key) }}
{% endif %}
RESTIC_HOST={{ shq(backups_restic_host | default(tailscale_hostname | default('fablab-prod'))) }}
RESTIC_KEEP_DAILY={{ backups_restic_keep_daily | default(7) }}
RESTIC_KEEP_WEEKLY={{ backups_restic_keep_weekly | default(4) }}
RESTIC_KEEP_MONTHLY={{ backups_restic_keep_monthly | default(6) }}
{% endif %}
