#!/usr/bin/env bash
# Managed by Ansible (lab-stack/ansible/roles/backups). MongoDB dump -> encrypt (age) -> off-box
# (restic). Secrets/config come from /etc/fablab/{mongo,backup}.env at runtime — NEVER hardcode
# them here (@rules/workflow-secrets.md). An untested backup is not a backup: drill with
# lab-stack/scripts/mongo-restore-drill.sh (docs/runbooks/backup-restore.md).
set -euo pipefail
IFS=$'\n\t'

# Shared plumbing: BACKUP_DIR, retention, /etc/fablab/backup.env, finalize_artifact().
# shellcheck source=/dev/null
. /usr/local/lib/fablab-backup-lib.sh

STAMP="$(date -u +%Y%m%dT%H%M%SZ)"          # UTC, monotonic-safe naming (@rules/topic-numeric-correctness.md)
OUT="${BACKUP_DIR}/mongo-${STAMP}.archive.gz"

# Mongo connection (roles/mongodb writes this): MONGODB_URI + MONGO_BACKUP_NETWORK + MONGO_IMAGE.
# shellcheck source=/dev/null
if [ -f /etc/fablab/mongo.env ]; then . /etc/fablab/mongo.env; fi
: "${MONGODB_URI:?MONGODB_URI must be set (roles/mongodb writes /etc/fablab/mongo.env)}"

umask 077
mkdir -p "${BACKUP_DIR}"

# 1) Dump. MongoDB is PRIVATE to the docker network (no host port), so run mongodump in an
#    ephemeral container ON that network and stream the compressed archive to disk.
docker run --rm --network "${MONGO_BACKUP_NETWORK:-fablab}" "${MONGO_IMAGE:-mongo:7.0}" \
  mongodump --uri="${MONGODB_URI}" --archive --gzip > "${OUT}"
[ -s "${OUT}" ] || { echo "ERROR: dump produced an empty archive (check Mongo auth)"; rm -f "${OUT}"; exit 1; }

finalize_artifact "${OUT}" mongo 'mongo-*.archive.gz*'
