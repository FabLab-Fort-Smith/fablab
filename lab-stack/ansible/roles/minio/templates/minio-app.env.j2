# Managed by Ansible (roles/minio). App-facing S3 settings for {{ minio_bucket }}. 0600, root-only.
# Copy these into ../.env / .env.production (or the Coolify app env) — the credential here is
# BUCKET-SCOPED (policy {{ minio_bucket }}-rw), never the MinIO root user.
S3_ENDPOINT=http://{{ minio_container_name }}:{{ minio_api_port }}
S3_REGION={{ minio_region }}
S3_BUCKET_NAME={{ minio_bucket }}
S3_ACCESS_KEY={{ minio_app_user }}
S3_SECRET_KEY={{ minio_app_pw }}
