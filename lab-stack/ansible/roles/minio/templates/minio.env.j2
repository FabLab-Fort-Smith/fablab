# Managed by Ansible (roles/minio). ROOT credentials for the MinIO server. 0600, root-only.
# NEVER put these in an application environment — the app gets a bucket-scoped user instead
# (production was found using the ROOT credential against a shared instance; see issue #96).
MINIO_ROOT_USER={{ minio_root_user }}
MINIO_ROOT_PASSWORD={{ minio_root_pw }}
MINIO_REGION={{ minio_region }}
# Console is reachable only from inside the docker network unless minio_publish_ports is set.
MINIO_BROWSER_REDIRECT_URL=http://{{ minio_container_name }}:{{ minio_console_port }}
