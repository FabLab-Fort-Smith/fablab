# --- Secrets & local config (never commit — @rules/workflow-secrets.md) ---
.env
.env.*
!.env.example
*.local
secrets/
*.pem
*.key
*.crt
*_rsa
*_ed25519

# --- IaC / platform state ---
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example
ansible/*.retry
.vault-pass*
# lab-stack: local Ansible inventory + group_vars carry the real VPS host/keys — never commit;
# only the committed *.example templates are tracked.
lab-stack/ansible/inventory.ini
lab-stack/ansible/group_vars/*.yml
!lab-stack/ansible/group_vars/*.example.yml

# --- Build output ---
dist/
build/
out/
public/build/
.cache/
.astro/
.next/
.svelte-kit/
node_modules/

# --- Logs & tmp ---
*.log
tmp/
.DS_Store
