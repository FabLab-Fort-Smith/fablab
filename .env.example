# Example environment for the fablab monorepo (platform + The-Lab app).
# Copy to `.env` (git-ignored) and fill real values from the secret store — NEVER commit secrets.
# @rules/workflow-secrets.md · @rules/topic-config-environments.md
#
# CONVENTIONS (important):
#  - Comments live on their OWN line, never inline after `KEY=value`. An inline `# ...` becomes part
#    of the value when this file is copied/sourced — it silently broke AUTH_SECRET once. Keep values bare.
#  - Values containing shell metacharacters must be single-quoted in `.env`; the tooling writes them quoted.
#  - Key names below MATCH the app's real process.env usage (lab-site/the-lab) + src/lib/env.js REQUIRED_ENV.

# ═══ Platform: host (provider-agnostic; RackNerd to start — ADR 0004) ═══
LAB_VPS_HOST=
LAB_VPS_SSH_USER=deploy
LAB_VPS_SSH_PORT=22

# ═══ Platform: RackNerd SolusVM client API (OPTIONAL — control-plane only; lab-stack/racknerd/) ═══
# Per-VPS key+hash from the panel API tab: IP auto-discovery + status/power. Never commit the secrets.
RACKNERD_API_BASE=https://nerdvm.racknerd.com/api/client/command.php
# RACKNERD_API_KEY=
# RACKNERD_API_HASH=

# ═══ Platform: Tailscale (tailnet-only admin — topic-tailnet-dev-access; ansible tailscale role) ═══
# Non-ephemeral, pre-approved auth key from the Tailscale admin console. Never commit.
# TAILSCALE_AUTHKEY=

# ═══ Platform: domains (ADR 0002) ═══
LAB_PRIMARY_DOMAIN=fablabfortsmith.org
LAB_PREVIEW_WILDCARD=*.preview.fablabfortsmith.org
COOLIFY_FQDN=deploy.fablabfortsmith.org

# ═══ Platform: forges (ADR 0003) — GitHub primary, GitLab mirror ═══
GITHUB_ORG=FabLab-Fort-Smith
GITLAB_GROUP=

# ═══ Platform: edge (Cloudflare DNS) — lab-stack/cloudflare/dns.sh ═══
CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ZONE_ID optional; auto-resolved from LAB_PRIMARY_DOMAIN if blank.
CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN -> secret store, scoped Zone:DNS:Edit for the zone. Never commit.
# CLOUDFLARE_API_TOKEN=
# CF_ACCESS_TOKEN -> secret store, Account:Access-Apps-and-Policies:Edit (for cloudflare/access.sh).
# A SEPARATE token from the DNS one — do not widen CLOUDFLARE_API_TOKEN. Never commit.
# CF_ACCESS_TOKEN=
# ACCESS_ALLOWED_EMAILS -> comma-separated maintainer emails allowed to reach the Coolify dashboard
# via Cloudflare Access (MFA required). `make access` reads this; unset = john.annis@... only.
# ACCESS_ALLOWED_EMAILS=admin@example.com,maintainer@example.com

# ═══ Shared secret vault — Vaultwarden over ZeroTier (make secrets-pull) ═══
# `make secrets-pull` pulls the platform secrets from the shared vault into THIS .env (the vault
# is the source of truth; custody P0 — docs/runbooks/shared-custody.md). None of these are secret:
# VAULT_URL        the ZeroTier-reachable Vaultwarden URL (join the ZT net first — zerotier role).
# VAULT_EMAIL      your vault login (only needed if `bw` isn't already authenticated).
# VAULT_COLLECTION collection to pull (default: "Default collection/Infrastructure").
# VAULT_CACERT     optional path to the server's TLS cert to trust (else it's fetched TOFU per run).
# The master password is prompted by `bw` on the TTY (never stored); set BW_PASSWORD for CI.
# VAULT_URL=https://10.121.16.224:8000
# VAULT_EMAIL=you@example.org
# VAULT_COLLECTION=Default collection/Infrastructure

# ═══ PER-ENVIRONMENT APP SECRETS (important) ═══
# THIS file's app values are STAGING. Production keeps its own git-ignored file, `.env.production`,
# and `coolify/reconcile.sh --env production` reads ONLY that (it fails closed if absent, so a prod
# apply can never push staging secrets). Platform creds (COOLIFY_URL/TOKEN) always come from `.env`.
#   staging     -> .env              (app the-lab-staging, branch dev,  staging.<domain>)
#   production  -> .env.production   (app the-lab-production, branch main, <domain> + www)
# DANGER — ENCRYPTION_KEY in .env.production MUST be the EXISTING production key. Member emails are
# encrypted at rest with it; a freshly generated key makes every stored email undecryptable (logins
# by email break, outreach can't resolve recipients). Never let `make secrets` overwrite it.
# See docs/runbooks/promote-staging-to-prod.md.

# ═══ Platform: Coolify API (over the tailnet — ADR 0012) — lab-stack/coolify/ ═══
COOLIFY_URL=http://fablab-prod:8000
# COOLIFY_TOKEN is a Laravel-Sanctum "id|secret" — single-quote it in .env (the '|' breaks sourcing).
# From Coolify → Keys & Tokens → API; abilities read + write + deploy (not root). Never commit.
# A dead/truncated token fails with a bare HTTP 401 and blocks ALL deploys + config-as-code while
# Coolify still looks healthy — mint/validate/store/revoke per docs/runbooks/coolify-token-rotation.md.
# Also kept in the vault (Infrastructure → "Coolify API token — fablab-prod") for `make secrets-pull`.
# COOLIFY_TOKEN=

# ═══ App database — self-hosted MongoDB on the VPS (ADR 0007/0010) ═══
# MONGO_ROOT_PASSWORD / MONGO_APP_PASSWORD are AUTO-GENERATED by `make secrets`.
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
# MONGODB_URI is built from the app password: mongodb://thelab_app:<pw>@fablab-mongo:27017/thelab?authSource=thelab
MONGODB_URI=
MONGODB_NAME=thelab

# ═══ Backups — at-rest encryption (age) + off-box (restic). OPT-IN (empty = local-only) ═══
# Enabling steps: docs/runbooks/backup-restore.md (§ Enabling encryption + off-box).
# age recipient = PUBLIC key from an OFFLINE `age-keygen` identity (safe to commit-adjacent; the
# private key stays off the box so a VPS compromise can't decrypt backups). e.g. age1qz...
BACKUP_AGE_RECIPIENT=
# restic off-box repo (S3-compatible), its encryption password, and a BACKUP-ONLY S3 key pair
# (least privilege — NOT the app's S3 creds). RESTIC_PASSWORD is unrecoverable if lost → store it
# safely (a lost password means the repo can't be decrypted).
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# ═══ App auth + local secrets — AUTO-GENERATED by `make secrets` (rotate: ARGS=--force) ═══
AUTH_SECRET=
JWT_SECRET=
# ENCRYPTION_KEY must be EXACTLY 32 bytes (make secrets produces this).
ENCRYPTION_KEY=
INTERNAL_API_SECRET=
SOCKET_API_SECRET=

# ═══ App URLs (staging = https://staging.fablabfortsmith.org) ═══
NEXTAUTH_URL=
APP_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_URL=
ADMIN_EMAIL=
LOG_LEVEL=info
# Deployment environment label shown in the app UI (sidebar footer). BUILD-time (client-inlined),
# so it must be set PER Coolify app + rebuilt: staging=staging, previews=preview, prod=production.
# Falls back to NODE_ENV (always "production" in a built app) if unset — which mislabels staging.
NEXT_PUBLIC_APP_ENV=

# ═══ App: object storage — external S3-compatible (ADR 0007) ═══
S3_ENDPOINT=https://s3.crittercodes.dev
S3_REGION=
S3_BUCKET_NAME=
# S3_ACCESS_KEY / S3_SECRET_KEY -> secret store; never commit.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ═══ App: email — transactional mailer via SMTP (defaults to PurelyMail, our own mail infra) ═══
# Sends verification / password-reset / notification emails through a dedicated SENDING mailbox
# (distinct from the member-mailbox provisioning plugin, which uses PURELYMAIL_API_TOKEN).
# EMAIL_HOST/EMAIL_PORT default to smtp.purelymail.com:465 (implicit TLS); use 587 for STARTTLS.
# EMAIL_USER = full address (e.g. noreply@fablabfortsmith.org); EMAIL_PASS = its password/app-password
# -> secret store, never commit. NEXT_PUBLIC_URL must be set too (used in the email links).
EMAIL_HOST=smtp.purelymail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=

# ═══ App: payments — Square (PCI: hosted/tokenized fields, SAQ-A; NEVER store PAN/SAD) ═══
# Staging uses SANDBOX. NEXT_PUBLIC_* are client-exposed (not secret).
SQUARE_ENVIRONMENT=sandbox
NEXT_PUBLIC_SQUARE_APP_ID=
SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
# SQUARE_SDK_VERSION optional (defaults v39; v44 for the cutover — The-Lab #127).
SQUARE_SDK_VERSION=
# SQUARE_ACCESS_TOKEN / SQUARE_WEBHOOK_SIGNATURE_KEY -> secret store; never commit.
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# ═══ App: AI (Google Gemini) ═══
# GEMINI_API_KEY -> secret store; cap tokens/cost; no PII in prompts.
GEMINI_API_KEY=

# ═══ App: abuse protection (Cloudflare Turnstile — ADR 0015, replaced reCAPTCHA) ═══
# Minted by `cd lab-stack && make provision-keys ARGS=turnstile` (needs a Turnstile:Edit token).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is client-exposed + BUILD-time (inlined); TURNSTILE_SECRET_KEY -> secret store (runtime).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ═══ App: social sign-in (OAuth — Auth.js Google + Discord providers) ═══
# Tier-3 console creds (ADR 0015): create/fetch in the Google Cloud Console + Discord Developer
# Portal. Register the redirect URI PER ENVIRONMENT: https://<host>/api/auth/callback/{google,discord}
# (staging = https://staging.fablabfortsmith.org/...). Runtime secrets (server-side) -> secret store;
# NOT build-time (do NOT prefix NEXT_PUBLIC). Missing => "client_id undefined" and sign-in fails.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ═══ App: optional integrations (set only if used) — IoT / Discord / orchestrator ═══
# WS_SERVER_URL= ; ACCESS_CONTROL_API_URL= ; ORCHESTRATOR_URL= ; ORCHESTRATOR_SECRET=
# DISCORD_BOT_TOKEN= ; DISCORD_CLIENT_ID= ; DISCORD_CLIENT_SECRET= ; DISCORD_PUBLIC_KEY= ; DISCORD_GUILD_ID= ; DISCORD_BOUNTY_CHANNEL_ID=
# WIFI_SSID= ; WIFI_PASSWORD= ; IMAGE_PROXY_ALLOWED_HOSTS=
