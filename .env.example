# Example environment for the fablab monorepo (platform + The-Lab app).
# Copy to `.env` (git-ignored) and fill real values from the secret store — NEVER commit secrets.
# @rules/workflow-secrets.md · @rules/topic-config-environments.md
# Real secrets live in Coolify / the secret store and are injected at runtime; this file lists
# the keys so bootstrap tooling and contributors know what's required.

# ─── Platform: host (provider-agnostic; RackNerd to start — ADR 0004) ───
LAB_VPS_HOST=                 # e.g. 203.0.113.10  (the RackNerd VPS IP)
LAB_VPS_SSH_USER=deploy       # non-root sudo user created by cloud-init
LAB_VPS_SSH_PORT=22

# ─── Platform: RackNerd SolusVM client API (OPTIONAL — control-plane only) ───
# Per-VPS key + hash from the panel API tab (nerdvm.racknerd.com). Used by lab-stack/racknerd/api.sh
# for IP auto-discovery (fills LAB_VPS_HOST in `make setup`) + status/power. It CANNOT create or
# reinstall the box (panel/WHMCS only) and is not the config transport (Ansible uses SSH). Leave
# unset to skip — you'll just enter the IP by hand. Secrets: never commit; store in .env only.
RACKNERD_API_BASE=https://nerdvm.racknerd.com/api/client/command.php
# RACKNERD_API_KEY / RACKNERD_API_HASH -> .env (git-ignored) / secret store; per-VPS, least privilege.

# ─── Platform: domains (ADR 0002) ───
LAB_PRIMARY_DOMAIN=fablabfortsmith.org
LAB_PREVIEW_WILDCARD=*.preview.fablabfortsmith.org
COOLIFY_FQDN=deploy.fablabfortsmith.org

# ─── Platform: forges (ADR 0003) — GitHub primary, GitLab mirror ───
GITHUB_ORG=FabLab-Fort-Smith
GITLAB_GROUP=                 # mirror
# GitHub App / GitLab tokens + per-forge webhook HMAC secrets -> secret store, not here.

# ─── Platform: edge (Cloudflare DNS) — used by lab-stack/cloudflare/dns.sh ───
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=            # optional; auto-resolved from LAB_PRIMARY_DOMAIN if blank
# CLOUDFLARE_API_TOKEN -> secret store / shell env, scoped to Zone:DNS:Edit for the zone only.
# PREVIEW_PROXIED=false       # proxied wildcard needs Cloudflare Enterprise; default DNS-only

# ─── Platform: Coolify API — used by lab-stack/coolify/bootstrap.sh ───
COOLIFY_URL=                  # e.g. https://deploy.fablabfortsmith.org
# COOLIFY_TOKEN -> secret store / shell env (Coolify: Keys & Tokens > API)

# ─── App (lab-site/main = The-Lab): database — self-hosted MongoDB on VPS (ADR 0007) ───
MONGO_ROOT_PASSWORD=          # MongoDB root password (AUTO-GENERATED); set on the Coolify Mongo service
MONGO_APP_PASSWORD=           # least-privilege app-user password (AUTO-GENERATED)
MONGODB_URI=                  # mongodb://<appuser>:<MONGO_APP_PASSWORD>@<coolify-mongo-host>:27017/<db>

# ─── App: auth + local app secrets (AUTO-GENERATED by `make secrets` / `make setup`) ───
# Generated locally into .env; non-destructive (kept on re-run). Rotate: `make secrets ARGS=--force`.
AUTH_SECRET=                  # NextAuth session secret (auto-generated)
JWT_SECRET=                   # app JWT signing secret (auto-generated)
ENCRYPTION_KEY=               # PII field-encryption key — exactly 32 bytes (auto-generated)
INTERNAL_API_SECRET=          # internal/IoT API bearer secret (auto-generated)
SOCKET_API_SECRET=            # socket/IoT control API bearer secret (auto-generated)
AUTH_URL=                     # e.g. https://fablabfortsmith.org
# OAuth provider client IDs/secrets -> secret store.

# ─── App: object storage — external S3-compatible (ADR 0007) ───
S3_ENDPOINT=https://s3.crittercodes.dev
S3_BUCKET=
S3_REGION=
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY -> secret store (least-privilege key).

# ─── App: email — external SMTP (ADR 0007) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
# SMTP_USER / SMTP_PASS -> secret store.

# ─── App: payments — Square (PCI: hosted/tokenized fields, SAQ-A) ───
SQUARE_ENVIRONMENT=sandbox    # sandbox | production
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
# SQUARE_ACCESS_TOKEN -> secret store. NEVER store card data / SAD anywhere.

# ─── App: AI (Google GenAI) ───
# GOOGLE_GENAI_API_KEY -> secret store. Cap tokens/cost; no PII in prompts.

# ─── App: abuse protection (Google reCAPTCHA) ───
RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY -> secret store.
