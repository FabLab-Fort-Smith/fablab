# On-site door broker (Tier-1) runtime config — placeholders only. Copy to `.env` on the Proxmox host
# and fill in real values from the secret vault. NEVER commit the filled-in .env (it's git-ignored).
# Certs/key/registry are MOUNTED via ./certs (see docker-compose.broker.yml), not set here.

# Cloud uplink (Link-B) — must be wss:// (scheme enforced; broker validates + pins the cloud cert)
CLOUD_UPLINK_URL=wss://cloud.example.org/broker
# The broker's bearer for the cloud uplink (constant-time verified cloud-side)
BROKER_UPLINK_SECRET=REPLACE_WITH_BROKER_BEARER
# OPTIONAL — pin the cloud's TLS CA/cert (path to a PEM, mounted read-only). Leave UNSET to verify the
# cloud cert against Node's bundled PUBLIC roots (the cloud is edge-terminated with a public/LE cert).
# This is SEPARATE from ./certs/ca.crt (the internal edge CA); do NOT point it at the internal CA.
# Recommended for production hardening: pin the cloud's issuer chain here.
# BROKER_UPLINK_CA=/certs/cloud-ca.pem
# 32-byte base64 per-broker index key (brokerIndexKey), cloud-provisioned
BROKER_INDEX_KEY=REPLACE_WITH_BASE64_32B_KEY
# Ed25519 spki public key (base64) that verifies envelope signatures
DOOR_ALLOWLIST_VERIFY_KEY=REPLACE_WITH_ED25519_SPKI_BASE64
# The Proxmox host LAN IP to bind Link-A to (never 0.0.0.0 / public)
BROKER_LAN_IP=10.0.0.2
# Optional (defaults shown)
BROKER_LISTEN_PORT=8443
BROKER_HEALTH_PORT=9090
